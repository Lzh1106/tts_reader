<?xml version="1.0" encoding="utf-8"?>
<!-- flutter_downloader 的 DownloadedFileProvider 路径声明 -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 应用外部私有目录（下载目录所在） -->
    <external-path
        name="external_path"
        path="." />
    <!-- 内部缓存目录 -->
    <cache-path
        name="cache_path"
        path="." />
    <!-- 内部文件目录 -->
    <files-path
        name="files_path"
        path="." />
    <!-- 应用外部文件目录 -->
    <external-files-path
        name="external_files_path"
        path="." />
</paths>
